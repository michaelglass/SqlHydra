BEGIN TRY
    INSERT INTO [ext].[GetIdGuidRepro] ([Id], [EmailAddress]) VALUES (@p0, @p1)
END TRY
BEGIN CATCH
    DECLARE @err INT = ERROR_NUMBER();
    IF @err NOT IN (2627, 2601) THROW;

    UPDATE t SET [EmailAddress] = @__update_EmailAddress
    FROM [ext].[GetIdGuidRepro] AS t
    WHERE (
        (t.[Id] = @__key_Id OR (t.[Id] IS NULL AND @__key_Id IS NULL))
    );

    IF @@ROWCOUNT = 0
    BEGIN
        INSERT INTO [ext].[GetIdGuidRepro] ([Id], [EmailAddress]) VALUES (@p0, @p1)
    END
END CATCH;

SQL: 
BEGIN TRY
    INSERT INTO [ext].[NullableKeyUpsert] ([Key1], [Key2], [Value]) VALUES (@p0, @p1, @p2)
END TRY
BEGIN CATCH
    DECLARE @err INT = ERROR_NUMBER();
    IF @err NOT IN (2627, 2601) THROW;

    UPDATE t SET [Value] = @__update_Value
    FROM [ext].[NullableKeyUpsert] AS t
    WHERE (
        (t.[Key1] = @__key_Key1 OR (t.[Key1] IS NULL AND @__key_Key1 IS NULL)) AND
        (t.[Key2] = @__key_Key2 OR (t.[Key2] IS NULL AND @__key_Key2 IS NULL))
    );

    IF @@ROWCOUNT = 0
    BEGIN
        INSERT INTO [ext].[NullableKeyUpsert] ([Key1], [Key2], [Value]) VALUES (@p0, @p1, @p2)
    END
END CATCH;
- @p0: UniqueIdentifier: 5cd6674a-fc28-4fb9-ba0b-c004ac1793ea
- @p1: NVarChar: 
- @p2: NVarChar: updated
